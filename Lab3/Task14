# password check

p = input("Password: ")
up = low = num = sym = False
sc=0
for ch in p:
    if ch.isupper(): 
        up = True
    elif ch.islower(): 
        low = True
    elif ch.isdigit(): 
        num = True
    elif ch in "$#@": 
        sym = True
        sc+=1

if up and low and num and sym and 6 <= len(p) <= 16 and sc==2 :
    print("Valid password")
else:
    print("Invalid password")